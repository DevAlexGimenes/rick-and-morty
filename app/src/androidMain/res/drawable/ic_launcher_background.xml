<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer (R8, issue #44).

  Simple two-stop radial gradient in the dark-navy family, using R1's exact theme tokens
  (core/designsystem/.../theme/Color.kt) rather than inventing new colors:
    - center stop: SurfaceDark  (#FF1C1E3D) - a touch lighter, reads as a soft glow behind the ring
    - edge stop:   BackgroundDark (#FF14152B) - the app's true background navy

  This layer fills the entire 108x108dp adaptive-icon canvas edge-to-edge; launchers apply their
  own mask (circle/squircle/square) on top of it, so it deliberately does NOT respect the 66dp
  safe zone the way the foreground layer does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:tileMode="clamp">
                <item android:color="#FF1C1E3D" android:offset="0.0" />
                <item android:color="#FF14152B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
