<?xml version="1.0" encoding="utf-8"?>
<!--
  R9 (issue #45) - Android 12+ SplashScreen `windowSplashScreenAnimatedIcon` mark, light-theme
  variant. Reuses ic_launcher_monochrome.xml's exact ring-glyph geometry (per LUMA's proposal:
  "not the full adaptive-icon composition, just the glyph itself" - no highlight arc), but unlike
  the monochrome layer this renders as-is (splash icons are not OS-retinted the way the
  adaptive-icon monochrome layer is), so it needs a real brand color rather than an opaque
  placeholder.

  Stroke color: PrimaryLight (`#FF41841D`) from core:designsystem's Color.kt (R1, issue #37) -
  the exact same value LUMA's proposal called a "deepened PrimaryLight" (this token was already
  darkened from LUMA's original `#4C9A22` proposal in R1 for WCAG AA contrast reasons - see
  Color.kt kdoc - so no further deepening is applied here).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF41841D"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1 1 54,80 A26,26 0 1 1 54,28 Z" />
</vector>
