<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer (R8, issue #44).

  Simplified static translation of the "portal ring" glyph concept from
  core/designsystem/.../component/PortalRingGlyph.kt (R3, issue #39) into a launcher-icon-safe
  vector drawable - NOT a reuse of that Compose component itself, since launcher icons are
  rasterized/masked XML resources, not runtime Compose. Same visual language (a bold ring plus a
  lighter highlight arc suggesting glow/depth), reduced to exactly two tones as required for a
  legible small-scale icon:
    - base ring:      PrimaryDark  (#FF8FDB4A) - the app's brand portal-swirl green
    - highlight arc:  AccentDark   (#FF3DFF7A) - the portal-glow accent token, used here for
                       exactly the "glow" purpose its scope constraint reserves it for

  Geometry: a closed circular ring (torus) centered at (54,54) with radius 26 and 8dp stroke
  width, so its outer edge sits at radius 30 - inside the 66dp safe zone's radius-33 boundary
  (108dp canvas, safe zone = inner 66dp), giving a 3dp margin so the glyph is never clipped by
  circle/squircle/square adaptive-icon masks. The highlight arc traces the top of the same ring
  (from -160deg to -20deg, i.e. through the 12 o'clock point) at a thinner 3.5dp stroke, reading
  as a light source from above.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base ring / torus. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF8FDB4A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1 1 54,80 A26,26 0 1 1 54,28 Z" />
    <!-- Highlight arc: lighter tone across the top of the ring, suggesting glow/depth. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3DFF7A"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M29.57,45.11 A26,26 0 0 1 78.43,45.11" />
</vector>
